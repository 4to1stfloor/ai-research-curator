# LLM API Keys (at least one required)
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Image Generation
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Email for PubMed API (recommended for higher rate limits)
PUBMED_EMAIL=your_email@example.com

# Optional: Email notification (Gmail SMTP)
# Gmail App Password 발급: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Optional: Slack DM notification (무료)
# Bot Token 발급: https://api.slack.com/apps (자세한 내용은 README 참조)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_USER_EMAIL=your_email_in_slack@example.com

# Optional: Institutional library proxy (n2s / EZproxy 스타일)
# 기관 도서관 구독으로 non-OA 논문 PDF 다운받을 때만 사용
# ⚠️  대부분 라이선스가 automated tools를 금지합니다. 주 몇 편 수준의 개인
#     리서치 용도로만 사용하고, 대량 다운로드 금지.
LIBPROXY_URL=https://libproxy.your-institution.kr:8443
LIBPROXY_ID=your_library_id
LIBPROXY_PASSWORD=your_library_password
