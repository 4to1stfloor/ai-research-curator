# LLM API Keys (at least one required)
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Image Generation
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Email for PubMed API (recommended for higher rate limits)
PUBMED_EMAIL=your_email@example.com

# Optional: Email notification (Gmail SMTP)
# Gmail App Password 발급: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Optional: Slack DM notification (무료)
# Bot Token 발급: https://api.slack.com/apps (자세한 내용은 README 참조)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_USER_EMAIL=your_email_in_slack@example.com
